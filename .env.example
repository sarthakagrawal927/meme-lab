# No npm install is needed. Copy to .env and restart the server after editing.
PORT=4317
# Empty MODEL keeps the model button disabled; the catalogue/baseline still work.
MEME_MODEL=
# Local Ollama defaults. Use a locally installed model; do not choose a cloud model for private inputs.
MEME_API_STYLE=ollama
MEME_API_BASE_URL=http://127.0.0.1:11434
MEME_API_KEY=
MEME_TIMEOUT_MS=120000
MEME_CONTEXT_TOKENS=16384
MEME_TEMPERATURE=0.2
# A non-loopback upstream is blocked unless you explicitly opt in below.
MEME_ALLOW_REMOTE=false
# Alternative: an authorized chat-completions-compatible endpoint.
# MEME_API_STYLE=chat_completions
# MEME_API_BASE_URL=http://127.0.0.1:1234/v1
# Some compatible providers reject response_format: set this to false if required.
MEME_JSON_MODE=true
