{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meme-lab-relevance-case-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "context", "intent_label", "acceptable_ids", "failure_modes", "review_status", "human_validated"],
  "properties": {
    "id": {"type": "string", "pattern": "^eval-(?:v1|stage300)-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "context": {"type": "string", "minLength": 30},
    "intent_label": {"enum": ["humour", "no_meme"]},
    "acceptable_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "failure_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["wrong_target", "wrong_tone", "keyword_only", "forced_joke", "coverage_gap", "unsafe_humour", "overconfident"]}},
    "review_status": {"const": "pending_owner_review"},
    "human_validated": {"const": false}
  }
}
