{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "meme-lab-catalogue-tool-stage-3000",
  "main": "./catalogue-indexer.mjs",
  "compatibility_date": "2026-09-20",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "CATALOGUE_STAGE": "3000"
  },
  "vectorize": [
    {
      "binding": "MEME_INDEX",
      "index_name": "meme-lab-catalogue-stage-3000"
    }
  ]
}
