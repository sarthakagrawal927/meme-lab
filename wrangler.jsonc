{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meme-lab-play",
  "main": "worker/src/index.mjs",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./worker/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
