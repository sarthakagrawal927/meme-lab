{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meme-lab-play",
  "main": "worker/src/index.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "memes.significanthobbies.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./worker/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "MEME_INDEX",
      "index_name": "meme-lab-catalogue-stage-1000"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meme-lab-feedback",
      "database_id": "5d85d86c-6383-4409-be18-d3ac05042d69",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
